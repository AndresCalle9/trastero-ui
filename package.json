{
  "name": "@andrescalle9/ui",
  "version": "0.1.0",
  "description": "UI compartida (design tokens, componentes base y navegación cross-app) para el hub Trastero.",
  "license": "MIT",
  "author": "Andrés Calle <acalle@salvahealth.co>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "tailwind-preset.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "trastero",
    "ui",
    "react",
    "nextjs",
    "tailwindcss",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndresCalle9/trastero-ui.git"
  }
}
